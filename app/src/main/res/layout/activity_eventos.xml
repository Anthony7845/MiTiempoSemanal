<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Volver"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Eventos"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/color_red" />
        </LinearLayout>

        <!-- Panel Semanal (Sprint 3) -->
        <TextView
            android:id="@+id/tvRangoSemana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:text="Semana ..."
            android:textColor="@color/color_gray"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutContenedorPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp" />

        <AutoCompleteTextView
            android:id="@+id/actvTareaBusqueda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Buscar o escribir nombre de tarea..."
            android:textColor="@color/black"
            android:textColorHint="@color/color_gray"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:inputType="text"
            android:maxLines="1"
            android:autofillHints="name"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvCategoriaSeleccionada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Categoría: (Ninguna)"
            android:textSize="14sp"
            android:textColor="@color/color_gray"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/layoutEventoActivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvActivoInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Evento en curso: ..."
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnFinalizarEvento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Finalizar Evento"
                android:backgroundTint="@color/color_red"
                android:textColor="@android:color/white"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnIniciarEvento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Iniciar Evento"
            android:backgroundTint="@color/color_green"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:padding="14dp"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/color_gray"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Historial de Eventos"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <ListView
            android:id="@+id/lvEventos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:divider="@color/color_gray"
            android:dividerHeight="0.5dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
