<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="@android:color/white">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MiTempoSemanal"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/color_red"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvDeveloperInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Desarrollador: Anieto\nVersión: v0.1.0 (1)"
        android:textSize="14sp"
        android:textColor="@color/color_gray"
        android:gravity="center"
        android:layout_marginBottom="48dp" />

    <Button
        android:id="@+id/btnCategorias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gestionar Categorías"
        android:backgroundTint="@color/color_cyan"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:padding="12dp" />

    <Button
        android:id="@+id/btnTareas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gestionar Tareas"
        android:backgroundTint="@color/color_green"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:padding="12dp" />

</LinearLayout>
