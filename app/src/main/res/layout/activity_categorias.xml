<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/white">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gestión de Categorías"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/color_red"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/etCategoriaNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Nombre de categoría"
            android:textColor="@color/black"
            android:textColorHint="@color/color_gray"
            android:inputType="text"
            android:maxLines="1"
            android:autofillHints="name" />

        <Button
            android:id="@+id/btnGuardarCategoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Guardar"
            android:backgroundTint="@color/color_cyan"
            android:textColor="@color/black"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <ListView
        android:id="@+id/lvCategorias"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/color_gray"
        android:dividerHeight="1dp" />

</LinearLayout>
